# Sao chép thành server/.env để tùy chỉnh. KHÔNG commit file .env.
NODE_ENV=development
PORT=4000
# DB_FILE=./data/instasquad.db
# Khóa AES-256 (64 ký tự hex) cho dữ liệu eKYC/bằng chứng. Bắt buộc ở production.
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DATA_ENCRYPTION_KEY=
# Bí mật ký callback của cổng thanh toán mô phỏng. Bắt buộc ở production.
# PAYMENT_GATEWAY_SECRET=
# Công cụ demo (dịch đồng hồ, giả lập lỗi ghi sổ, reset). Mặc định bật ở dev, cấm bật ở production.
# DEMO_TOOLS=true
# SCHEDULER_INTERVAL_MS=2000
